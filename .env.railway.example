# Copy these non-secret values into Railway's service Variables (Raw Editor).
# Set before building; changing either public URL setting requires a rebuild.
NODE_ENV=production
TI4_BASE_PATH=/ti4
VITE_PUBLIC_ORIGIN=https://obsecsolutions.com
TI4_LAB_DATABASE_PATH=file:///data/sqlite.db
DISCORD_DISABLED=true
R2_INTEGRATION_DISABLED=true
# Leave analytics unconfigured, or use your own public PostHog project key.
VITE_POSTHOG_KEY=
# Railway supplies PORT automatically. Attach a persistent volume at /data.
