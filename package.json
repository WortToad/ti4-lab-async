{
  "name": "ti4-draft-command",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "tsx ./server.ts",
    "discord:deploy": "tsx ./app/discord/deployCommands.ts",
    "build": "react-router build",
    "start": "cross-env NODE_ENV=production tsx ./server.ts",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "db:migrations": "drizzle-kit generate --dialect=sqlite --out=./app/drizzle/migrations --schema=./app/drizzle/schema.server.ts",
    "db:backup": "flyctl ssh sftp get -a ti4-lab /data/sqlite.db ~/Downloads/ti4-lab_$(date +'%d_%m_%Y').db",
    "db:repair-preset-closed-tiles": "tsx ./scripts/repair-preset-closed-tiles.ts",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "sync-voices": "node sync-voices-wrangler.js",
    "test:visual": "playwright test appearance.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@dnd-kit/core": "^6.3.1",
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@prometheus-io/client": "^0.16.1",
    "@react-router/dev": "^8.3.1",
    "@react-router/express": "^8.3.1",
    "@react-router/fs-routes": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "@tabler/icons-react": "^3.46.0",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "howler": "^2.2.4",
    "immer": "^11.1.18",
    "isbot": "^5.2.2",
    "jotai": "^3.0.0",
    "jotai-zustand": "^0.6.0",
    "posthog-js": "^1.430.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-loading-indicators": "^1.0.1",
    "react-qr-code": "^2.2.0",
    "react-router": "^8.3.1",
    "remix-utils": "^10.0.0",
    "skia-canvas": "^3.0.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "use-sync-external-store": "^1.7.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "rolldown": "^1.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26.8.2 <27"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "**/@esbuild-kit/core-utils/esbuild": "^0.28.2"
  }
}
